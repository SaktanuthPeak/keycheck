{
	"name": "{{PROJECT_NAME}}",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev --host 0.0.0.0",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:e2e": "pnpm build && playwright test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"openapi": "openapi-typescript",
		"openapi:fetch": "mkdir -p src/libs/api-specs && curl -f http://localhost:9000/openapi.json -o src/libs/api-specs/fastapi.json",
		"openapi:fastapi": "openapi-typescript src/libs/api-specs/fastapi.json -o src/lib/api/paths/fastapi.d.ts",
		"openapi:update": "pnpm openapi:fetch && pnpm openapi:fastapi"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.48.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.6.3",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"formsnap": "^2.0.1",
		"globals": "^17.12.0",
		"mode-watcher": "^1.1.0",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.1",
		"vite-plugin-devtools-json": "^1.1.0",
		"zod": "^4.6.5"
	},
	"dependencies": {
		"@tanstack/svelte-query": "^6.3.0",
		"@tanstack/svelte-query-devtools": "^6.3.0",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.3",
		"jsonwebtoken": "^9.0.3",
		"openapi-fetch": "^0.17.0",
		"openapi-typescript": "^7.13.0",
		"pino": "^10.3.1"
	}
}
