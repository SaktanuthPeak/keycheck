# KeyCheck backend config (docs/api-contract.md §4). Copy to .env and set SESSION_SECRET.
# Relative paths resolve against backend/.
APP_ENV="dev"
DEBUG=false

# Empty = in-memory store + worker thread inside the API (W2); set = MongoDB + separate worker (./scripts/run-worker)
MONGODB_URI=""
# MONGODB_URI="mongodb://localhost:27017/keycheck"

STORAGE_ROOT="../var/storage"
MODEL_BUNDLE_DIR="../bundles/baseline_dev_v0"
OCR_DEVICE="cpu"

MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_PIXELS=24000000
QUEUE_CAPACITY=8
MAX_ACTIVE_JOBS_PER_SESSION=2
IMAGE_RETENTION_HOURS=24
METADATA_RETENTION_HOURS=168

# Required, >= 16 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET="change-me-to-a-long-random-string"
COOKIE_SECURE=false
# Empty = same-origin only (Origin host == Host). Example: '["http://localhost:5173"]'
ALLOWED_ORIGINS='[]'

WORKER_LEASE_SECONDS=120
WORKER_MAX_RETRIES=1
